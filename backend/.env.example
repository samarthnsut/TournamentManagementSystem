# LOCAL DEVELOPMENT ONLY — do not import this into a hosting provider.
#
# Every value here points at docker-compose.yml on localhost. Pasting the file into a deploy target
# (Render's "Add from .env", Fly secrets, a Compose override) produces a container that dials
# localhost:5432 for a database that is not there, and signs JWTs with the placeholder below, which
# is public. Set the deployed values by hand from the checklist in README.md.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/tms
DB_USERNAME=tms
DB_PASSWORD=tms
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
